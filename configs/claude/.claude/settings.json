{
  "includeCoAuthoredBy": false,
  "permissions": {
    "allow": [
      "WebSearch",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:medium.com)",
      "WebFetch(domain:stackoverflow.com)",
      "Bash(git:*)",
      "Bash(npm:*)",
      "Bash(node:*)",
      "Bash(tsc:*)",
      "Bash(npx:*)",
      "Bash(python:*)",
      "Bash(pip:*)",
      "Bash(poetry:*)",
      "Bash(uv:*)",
      "Bash(cargo:*)",
      "Bash(rustc:*)",
      "Bash(docker:*)",
      "mcp__plugin_telegram_telegram__reply",
      "mcp__plugin_telegram_telegram__react",
      "mcp__plugin_telegram_telegram__edit_message",
      "mcp__plugin_telegram_telegram__download_attachment",
      "Skill(telegram:configure)",
      "Skill(telegram:access)",
      "Read(//home/tkaneko/.claude/channels/telegram/**)",
      "Read(//home/tkaneko/.claude/plugins/cache/claude-plugins-official/telegram/0.0.6/**)",
      "Bash(mv ~/.claude/channels/telegram/.env.tmp ~/.claude/channels/telegram/.env)",
      "Bash(chmod 600 ~/.claude/channels/telegram/.env)",
      "Bash(mkdir -p ~/.claude/channels/telegram/approved)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)",
      "Bash(sudo:*)",
      "Bash(npm publish:*)",
      "Bash(yarn publish:*)",
      "Bash(poetry publish:*)",
      "Bash(uv publish:*)",
      "Bash(cargo publish:*)",
      "Bash(docker push:*)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(curl:*)"
    ]
  },
  "model": "opus[1m]",
  "enabledPlugins": {
    "codex@openai-codex": true,
    "telegram@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "openai-codex": {
      "source": {
        "source": "github",
        "repo": "openai/codex-plugin-cc"
      }
    }
  },
  "alwaysThinkingEnabled": true,
  "tui": "fullscreen",
  "theme": "dark",
  "remoteControlAtStartup": true,
  "agentPushNotifEnabled": true
}
