#!/bin/bash
# Launching onto an xrdp display needs a separate profile/extensions dir
# (singleton lock). Session detected from $DISPLAY, not $XRDP_SESSION.
# See docs/session-display.md.
REAL_BIN=/usr/share/code/bin/code

_disp=${DISPLAY#:}
_disp=${_disp%%.*}

if [ -n "$_disp" ] && [ -S "/run/xrdp/sockdir/xrdp_display_${_disp}" ]; then
    exec "$REAL_BIN" \
        --user-data-dir="$HOME/.vscode-remote-data" \
        --extensions-dir="$HOME/.vscode-remote-extensions" \
        "$@"
else
    exec "$REAL_BIN" "$@"
fi
