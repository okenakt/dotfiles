#!/bin/bash
# Launching onto an xrdp display needs a separate profile (singleton lock) and
# ANGLE's Vulkan backend (the xrdp X server has no GPU). Session detected from
# $DISPLAY, not $XRDP_SESSION.
# See docs/session-display.md and docs/remote-gpu.md.
REAL_BIN=/usr/bin/google-chrome-stable

_disp=${DISPLAY#:}
_disp=${_disp%%.*}

if [ -n "$_disp" ] && [ -S "/run/xrdp/sockdir/xrdp_display_${_disp}" ]; then
    exec "$REAL_BIN" \
        --user-data-dir="$HOME/.config/google-chrome-remote" \
        --use-angle=vulkan \
        "$@"
else
    exec "$REAL_BIN" "$@"
fi
