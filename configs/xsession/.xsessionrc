setxkbmap -layout us -model hhk

# In xrdp sessions (detected by the per-display control socket) export the two
# markers load_pw_modules.sh requires and load the xrdp PipeWire sink/source.
# See docs/remote-audio.md; do not reuse the markers as a session signal
# (docs/session-display.md).
_xrdp_disp=${DISPLAY#:}; _xrdp_disp=${_xrdp_disp%%.*}
if [ -n "$_xrdp_disp" ] && [ -S "/run/xrdp/sockdir/xrdp_display_${_xrdp_disp}" ]; then
    export XRDP_SESSION=1
    export XRDP_SOCKET_PATH=/run/xrdp/sockdir
    # Load the xrdp sink/source only when it is not present yet.
    if [ -x /usr/libexec/pipewire-module-xrdp/load_pw_modules.sh ] &&
        ! pw-cli ls Node 2>/dev/null | grep -q '"xrdp-sink"'; then
        /usr/libexec/pipewire-module-xrdp/load_pw_modules.sh >/dev/null 2>&1 &
    fi
fi
unset _xrdp_disp
